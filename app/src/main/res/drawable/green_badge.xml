<?xml version="1.0" encoding="utf-8"?>
<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:paddingMode="stack">
    <item>
        <shape>
            <corners
                android:radius="100dp" />
            <gradient
                android:angle="270"
                android:startColor="?attr/rolePrimaryLight"
                android:endColor="?attr/rolePrimaryLight" />
            <stroke
                android:width="1dp"
                android:color="?attr/rolePrimaryLight" />
            <padding
                android:left="28dp"
                android:right="12dp"
                android:top="6dp"
                android:bottom="6dp" />
        </shape>
    </item>
    <item
        android:width="8dp"
        android:height="8dp"
        android:left="12dp"
        android:gravity="left|center_vertical">
        <shape
            android:shape="oval">
            <solid
                android:color="?attr/rolePrimary" />
        </shape>
    </item>
</layer-list>
